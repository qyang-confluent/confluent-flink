-- 2. Model: text in (a batch of syslog lines from one host), JSON verdict out.
--    Output is LLM text: it may be wrapped in a code fence, so step 5 extracts the JSON object before parsing.
CREATE MODEL IF NOT EXISTS `${model_name}`
  INPUT (`text` STRING)
  OUTPUT (`verdict` STRING)
  COMMENT 'Off-the-shelf instruct SLM on vLLM acting as a SOC analyst over syslog'
  WITH (
    'task' = 'text_generation',
    'provider' = 'openai',
    'openai.connection' = '${connection_name}',
    'openai.model_version' = '${served_model}',
    'openai.system_prompt' = 'You are a SOC analyst reviewing Linux syslog lines from one host over one minute, joined by the pipe character. Decide whether they show hacking activity: SSH or password brute force, credential stuffing, login from unusual source after many failures, privilege escalation (sudo or su abuse, new root or uid 0 accounts), port scanning, new persistence (cron jobs, ssh keys, systemd units, new users), log tampering, or reverse shells and malware download. Routine events (cron, DHCP, ntp, a few typos in passwords, normal sudo by admins) are benign. Reply with ONLY one JSON object and nothing else. The verdict value must be exactly attack or benign (never none). Use category none when benign. Keep reason under 15 words. Format: {"verdict":"attack|benign","category":"brute_force|privilege_escalation|recon|persistence|defense_evasion|exfil_or_c2|none","confidence":0.0-1.0,"reason":"short evidence"}'
