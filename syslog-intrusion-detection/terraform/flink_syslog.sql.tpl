CREATE MODEL IF NOT EXISTS `${model_name}`
  INPUT (`${in_col}` STRING)
  OUTPUT (`${out_col}` STRING)
  COMMENT 'Instruct LLM acting as a SOC analyst over syslog'
%{ if backend == "vllm" ~}
  WITH (
    'task' = 'text_generation',
    'provider' = 'openai',
    'openai.connection' = '${connection_name}',
    'openai.model_version' = '${served_model}',
