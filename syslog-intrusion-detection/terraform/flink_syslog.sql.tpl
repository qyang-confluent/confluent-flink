-- 4. Pipeline (continuous), two named CTAS statements. Mirrors credit-card-fraud:
--    reads the latest offset only, writes table/topic `syslog_alerts`.
--    Source: topic `syslog` is schemaless JSON from Logstash ({host, message, ...}), so Flink exposes `val` BYTES.
--    Noise filter: this sandbox host emits constant kernel apparmor audit lines from container health checks; they are dropped
--    before the model sees them. Windows with fewer than 3 remaining lines are skipped to save GPU calls.
--    Prompt budget: server context is 8192 tokens, so the packed text is capped (~6000 chars ~= 2k tokens).
--    Verdict is forced to attack/benign because small models also answer 'none'.
--    Every window is scored (attack AND benign); filter on verdict downstream, or add WHERE verdict = 'attack'.
-- 4a. Statement `syslog-windowing`: filter + 1-minute per-host windows into table `syslog_windows`.
--     (ML_PREDICT cannot sit directly on a windowed aggregate, so windowing and scoring are two statements.)
CREATE TABLE `syslog_windows` AS
WITH src AS (
  SELECT ts, host, message
  FROM (
    SELECT `$rowtime` AS ts,
           JSON_VALUE(CAST(val AS STRING), '$.host')    AS host,
           JSON_VALUE(CAST(val AS STRING), '$.message') AS message
    FROM `syslog` /*+ OPTIONS('scan.startup.mode' = 'latest-offset') */
  )
  WHERE message NOT LIKE '%apparmor=%'
)
SELECT host, window_start, window_end, COUNT(*) AS line_count,
       SUBSTRING(LISTAGG(message, ' | ') FROM 1 FOR 6000) AS text
FROM TABLE(TUMBLE(TABLE src, DESCRIPTOR(ts), INTERVAL '1' MINUTE))
GROUP BY host, window_start, window_end
HAVING COUNT(*) >= 3;

-- 4b. Statement `syslog-scoring`: SLM verdict per window into `syslog_alerts`.
--     Verdict is forced to attack/benign because small models also answer 'none'. No WHERE after ML_PREDICT: the async
--     correlate rejects conditions, so unparseable replies come out as benign with NULL fields.
CREATE TABLE `syslog_alerts` AS
SELECT
  w.host, w.window_start, w.window_end, w.line_count,
  CASE WHEN LOWER(JSON_VALUE(REGEXP_EXTRACT(p.verdict, '(\{[^}]*\})', 1), '$.verdict')) = 'attack' THEN 'attack' ELSE 'benign' END AS verdict,
  JSON_VALUE(REGEXP_EXTRACT(p.verdict, '(\{[^}]*\})', 1), '$.category')                   AS category,
  CAST(JSON_VALUE(REGEXP_EXTRACT(p.verdict, '(\{[^}]*\})', 1), '$.confidence') AS DOUBLE) AS confidence,
  JSON_VALUE(REGEXP_EXTRACT(p.verdict, '(\{[^}]*\})', 1), '$.reason')                     AS reason,
  SUBSTRING(w.text FROM 1 FOR 300)                AS sample
FROM `syslog_windows` AS w, LATERAL TABLE(ML_PREDICT('${model_name}', w.text)) AS p;

